# ShellGuard E2E test config — KEY=value, sourced by shellguard.sh
SHELLGUARD_HOST=shellguard-e2e
POLL_INTERVAL=1
DEDUP_WINDOW=5
LOG_FILE=/var/log/shellguard.log
LOG_STDOUT=1

TELEGRAM_ENABLED=1
TELEGRAM_BOT_TOKEN=${SHELLGUARD_TG_TOKEN:-}
TELEGRAM_CHAT_ID=${SHELLGUARD_TG_CHAT:-}

SLACK_ENABLED=0
SLACK_WEBHOOK_URL=

WEBHOOK_ENABLED=0
WEBHOOK_URL=
WEBHOOK_SECRET=
