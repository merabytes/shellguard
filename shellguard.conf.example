# ShellGuard configuration — sourced as shell script (KEY=value)
# Copy to /etc/shellguard/shellguard.conf or ~/.config/shellguard/shellguard.conf

# ── General ─────────────────────────────────────────────────────────────────
SHELLGUARD_HOST=""          # leave empty → use hostname
POLL_INTERVAL=2             # seconds between ps snapshots
DEDUP_WINDOW=60             # ignore repeat events for same PID (seconds)
LOG_FILE="/var/log/shellguard.log"
LOG_STDOUT=1                # 1 = also print to stdout

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=""       # 123456789:AAxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=""         # numeric chat id or @channelusername

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_ENABLED=0
SLACK_WEBHOOK_URL=""        # https://hooks.slack.com/services/...

# ── Generic webhook ──────────────────────────────────────────────────────────
WEBHOOK_ENABLED=0
WEBHOOK_URL=""              # POST receives JSON: {"host":"...","text":"..."}
WEBHOOK_SECRET=""           # optional — adds X-ShellGuard-Signature header
