#!/bin/sh
set -e

case "$1" in
  configure)
    # Default config
    if [ ! -f /etc/shellguard/shellguard.conf ]; then
        cp /etc/shellguard/shellguard.conf.example /etc/shellguard/shellguard.conf
        echo "ShellGuard: config installed at /etc/shellguard/shellguard.conf"
        echo "Edit TELEGRAM_ENABLED=1 and set tokens before starting."
    fi

    # PAM hook
    PAM_COMMON=/etc/pam.d/common-session
    PAM_LINE="session optional pam_exec.so /usr/lib/shellguard/pam_hook.sh"
    if [ -f "$PAM_COMMON" ] && ! grep -qF "shellguard" "$PAM_COMMON"; then
        echo "$PAM_LINE" >> "$PAM_COMMON"
        echo "ShellGuard: PAM hook installed in $PAM_COMMON"
    fi

    # systemd (Debian/Ubuntu)
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable shellguard.service 2>/dev/null || true
        if [ -f /etc/shellguard/shellguard.conf ] && \
           grep -q '^TELEGRAM_ENABLED=1' /etc/shellguard/shellguard.conf 2>/dev/null; then
            systemctl restart shellguard.service || true
            echo "ShellGuard: systemd service started"
        else
            echo "ShellGuard: run 'shellguard-configure --start' to set Telegram and start"
        fi
    elif [ -f /etc/synoinfo.conf ] || [ -d /usr/syno ]; then
        echo "ShellGuard: Synology detected — run 'shellguard-configure --start'"
    fi
    ;;
esac

exit 0
